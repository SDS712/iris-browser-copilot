# Copy to .env for local development. Never commit the real .env.
IRIS_ENV=dev
IRIS_PUBLIC_URL=http://localhost:8000
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
TAVILY_API_KEY=your-tavily-api-key
IRIS_VOICE_FEMALE=eve
IRIS_VOICE_MALE=alba
IRIS_SPEAKABLE_SAY=false
LLM_MODEL_DEEP=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
# 1 swaps every upstream for a deterministic fake (no network calls)
IRIS_FAKE_UPSTREAMS=0
BUDGET_DAILY_USD=15
BUDGET_TOTAL_USD=130
BUDGET_TZ=Asia/Kolkata
BUDGET_START_DATE=2026-09-26
VOICE_MAX_SESSION_SECONDS=600
MAX_CONCURRENT_VOICE_SESSIONS=6
SEARCH_MONTHLY_CREDIT_LIMIT=900
KILL_SWITCH=0
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:4321,chrome-extension://kjcchlmlkmljbpaobhidapkobbbdfmap
DATA_DIR=.data
LOG_LEVEL=INFO
