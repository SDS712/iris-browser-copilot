# Extension build settings. Copy to .env and adjust.

# Backend URL baked into the build. Required for production builds (`pnpm build`, `pnpm zip`).
IRIS_API_BASE=http://localhost:8000/api

# true: mock voice (no microphone, no WebSocket, no AssemblyAI).
IRIS_MOCK_VOICE=false

# true: window.IrisDebug in the side panel and a matching content-script bridge.
IRIS_DEBUG=false
