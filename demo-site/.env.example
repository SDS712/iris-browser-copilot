# Demo site build settings. Copy to .env for local overrides.
# Absolute links and page metadata.
IRIS_PUBLIC_URL=http://localhost:4321
# The landing page's demo video (a YouTube link). Empty hides the section.
IRIS_VIDEO_URL=
# The repo link on the landing page. Empty hides the links.
IRIS_GITHUB_URL=
# The in-page Iris widget on /demo/* pages. On by default; false leaves it out.
IRIS_DEMO_WIDGET=true
# Where the widget sends its requests: this site's /api by default, or the backend's full
# URL (such as https://iris-backend.example.com/api) when it's on another domain.
IRIS_API_BASE=/api
