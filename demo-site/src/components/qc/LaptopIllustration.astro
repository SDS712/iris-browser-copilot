---
/** A friendly laptop, drawn for this project in indigo, lavender and white. */
---

<svg
  class="laptop"
  viewBox="0 0 480 340"
  role="img"
  aria-label="Illustration of the Nimbus 14 laptop"
>
  <defs>
    <linearGradient id="laptop-screen" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6366F1"></stop>
      <stop offset="1" stop-color="#4338CA"></stop>
    </linearGradient>
    <linearGradient id="laptop-base" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E0E7FF"></stop>
      <stop offset="1" stop-color="#C7D2FE"></stop>
    </linearGradient>
  </defs>
  <circle cx="400" cy="70" r="46" fill="#EDE9FE"></circle>
  <circle cx="70" cy="250" r="32" fill="#EDE9FE"></circle>
  <rect x="92" y="40" width="296" height="200" rx="16" fill="#1E1B4B"></rect>
  <rect x="104" y="52" width="272" height="176" rx="8" fill="url(#laptop-screen)"></rect>
  <rect x="126" y="76" width="120" height="12" rx="6" fill="#FFFFFF" opacity="0.9"></rect>
  <rect x="126" y="98" width="180" height="8" rx="4" fill="#FFFFFF" opacity="0.5"></rect>
  <rect x="126" y="114" width="150" height="8" rx="4" fill="#FFFFFF" opacity="0.5"></rect>
  <rect x="126" y="146" width="96" height="56" rx="10" fill="#FFFFFF" opacity="0.18"></rect>
  <rect x="234" y="146" width="120" height="56" rx="10" fill="#FFFFFF" opacity="0.18"></rect>
  <circle cx="240" cy="46" r="2.5" fill="#6366F1"></circle>
  <path
    d="M40 252 H440 L412 280 Q406 286 396 286 H84 Q74 286 68 280 Z"
    fill="url(#laptop-base)"
  ></path>
  <rect x="204" y="252" width="72" height="8" rx="4" fill="#A5B4FC"></rect>
  <rect x="330" y="120" width="96" height="40" rx="12" fill="#FFFFFF" stroke="#E5E7EB"></rect>
  <circle cx="350" cy="140" r="8" fill="#059669"></circle>
  <path
    d="M346 140 l3 3 l6 -6"
    stroke="#FFFFFF"
    stroke-width="2"
    fill="none"
    stroke-linecap="round"
  ></path>
  <rect x="364" y="134" width="50" height="6" rx="3" fill="#C7D2FE"></rect>
  <rect x="364" y="144" width="34" height="6" rx="3" fill="#E0E7FF"></rect>
</svg>

<style>
  .laptop {
    width: 100%;
    height: auto;
  }
</style>
